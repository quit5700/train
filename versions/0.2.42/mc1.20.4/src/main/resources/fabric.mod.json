{
  "schemaVersion": 1,
  "id": "fabric_train_simulator",
  "version": "@VERSION@",
  "name": "模拟火车",
  "description": "铁路、道岔、列车、车站、车辆段、编组货运与车票通行系统。",
  "authors": [
    "quit5700"
  ],
  "license": "All Rights Reserved",
  "environment": "*",
  "entrypoints": {
    "main": [
      "cn.quit5700.fabrictrain.FabricTrainMod"
    ],
    "client": [
      "cn.quit5700.fabrictrain.FabricTrainClient",
      "cn.quit5700.fabrictrain.FormationClient"
    ],
    "jade": [
      "cn.quit5700.fabrictrain.compat.jade.TrainJadePlugin"
    ]
  },
  "mixins": [
    "fabric_train_simulator.common.mixins.json",
    "fabric_train_simulator.client.mixins.json"
  ],
  "depends": {
    "minecraft": "1.20.4",
    "fabricloader": ">=0.19.3",
    "java": ">=17",
    "fabric-api-base": ">=0.4.37",
    "fabric-events-interaction-v0": ">=0.7.2",
    "fabric-item-group-api-v1": ">=4.0.27",
    "fabric-lifecycle-events-v1": ">=2.3.1",
    "fabric-networking-api-v1": ">=3.1.9",
    "fabric-object-builder-api-v1": ">=13.1.0",
    "fabric-registry-sync-v0": ">=4.0.21",
    "fabric-api": ">=0.97.3+1.20.4"
  },
  "suggests": {
    "fabric-blockrenderlayer-v1": ">=1.1.47",
    "fabric-rendering-v1": ">=3.2.1",
    "jade": "*"
  },
  "icon": "assets/fabric_train_simulator/icon.png"
}