{
  "schemaVersion": 1,
  "id": "fabric_train_simulator",
  "version": "@VERSION@",
  "name": "模拟火车",
  "description": "铁路、道岔、列车、车站、车辆段、编组货运与车票通行系统。",
  "authors": [
    "quit5700"
  ],
  "license": "All Rights Reserved",
  "environment": "*",
  "entrypoints": {
    "main": [
      "cn.quit5700.fabrictrain.FabricTrainMod"
    ],
    "client": [
      "cn.quit5700.fabrictrain.FabricTrainClient",
      "cn.quit5700.fabrictrain.FormationClient"
    ],
    "jade": [
      "cn.quit5700.fabrictrain.compat.jade.TrainJadePlugin"
    ]
  },
  "mixins": [
    "fabric_train_simulator.common.mixins.json",
    "fabric_train_simulator.client.mixins.json"
  ],
  "depends": {
    "minecraft": "1.21.11",
    "fabricloader": ">=0.19.3",
    "java": ">=21",
    "fabric-api-base": ">=1.0.5",
    "fabric-events-interaction-v0": ">=4.1.1",
    "fabric-item-group-api-v1": ">=4.2.36",
    "fabric-lifecycle-events-v1": ">=2.6.15",
    "fabric-networking-api-v1": ">=5.1.6",
    "fabric-object-builder-api-v1": ">=21.1.40",
    "fabric-api": ">=0.141.5+1.21.11"
  },
  "suggests": {
    "fabric-rendering-v1": ">=16.2.10",
    "jade": "*"
  },
  "icon": "assets/fabric_train_simulator/icon.png"
}